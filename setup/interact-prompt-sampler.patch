+def dataset_objects(labels):
+    # TextOnlyDataset stores the source dataset as the prefix in its legacy label.
+    objects = []
+    for label in labels:
+        dataset, separator, name = label.partition('_')
+        if not dataset or not separator or not name:
+            raise ValueError(f'Invalid dataset object label: {label!r}')
+        objects.append(ObjectRef(dataset, name))
+    return objects
