+"""Read explicit text and object pairs for Text2Interaction sampling."""
+
+from dataclasses import dataclass
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from data_loaders.tensors import collate
+
+
+DATA_ROOT = Path(__file__).resolve().parents[2] / 'data'
+
+
+@dataclass(frozen=True)
+class ObjectRef:
+    dataset: str
+    name: str
+
+    @property
+    def label(self):
+        return f'{self.dataset}_{self.name}'
+
+    @property
+    def mesh_path(self):
+        return DATA_ROOT / self.dataset / 'objects' / self.name / f'{self.name}.obj'
+
+
+@dataclass(frozen=True)
+class Prompt:
+    id: str
+    text: str
+    object: ObjectRef
+
+
+def read_prompts(args):
+    if args.input_text and args.text_prompt:
+        raise ValueError('Use only one of --input_text and --text_prompt.')
+    if not args.prompt_manifest:
+        if args.input_text or args.text_prompt:
+            raise ValueError('--input_text and --text_prompt require --prompt_manifest.')
+        return []
+
+    path = Path(args.prompt_manifest)
+    entries = json.loads(path.read_text(encoding='utf-8'))
+    if not isinstance(entries, list) or not entries:
+        raise ValueError(f'{path} must contain a nonempty JSON array of prompts.')
+
+    prompts = []
+    fields = ('id', 'text', 'dataset', 'object_name')
+    for index, entry in enumerate(entries, start=1):
+        if not isinstance(entry, dict) or any(
+            not isinstance(entry.get(field), str) or not entry[field].strip()
+            or entry[field].splitlines() != [entry[field]]
+            for field in fields
+        ):
+            raise ValueError(f'{path} entry {index} requires nonempty single-line strings for {", ".join(fields)}.')
+        dataset, name = entry['dataset'], entry['object_name']
+        for component in (dataset, name):
+            if component in ('.', '..') or any(char in component for char in ('/', '\\', '\0')):
+                raise ValueError(f'Invalid dataset or object name at {path} entry {index}: {component!r}')
+        prompts.append(Prompt(entry['id'].strip(), entry['text'].strip(), ObjectRef(dataset, name)))
+
+    if len({prompt.id for prompt in prompts}) != len(prompts):
+        raise ValueError(f'{path} contains duplicate prompt IDs.')
+    if args.input_text:
+        lines = Path(args.input_text).read_text(encoding='utf-8').splitlines()
+        if [line.strip() for line in lines] != [prompt.text for prompt in prompts]:
+            raise ValueError('--input_text must match the texts in --prompt_manifest, in the same order.')
+    if args.text_prompt:
+        prompts = [prompt for prompt in prompts if prompt.text == args.text_prompt.strip()]
+        if len(prompts) != 1:
+            raise ValueError('--text_prompt must match exactly one entry in --prompt_manifest.')
+    return prompts
+
+
+def load_object_geometry(obj):
+    if not obj.mesh_path.is_file():
+        raise FileNotFoundError(f'Missing mesh for {obj.label}: {obj.mesh_path}')
+    points_path = obj.mesh_path.with_name('sample_points.npy')
+    bps_path = DATA_ROOT / obj.dataset / 'objects_bps' / obj.name / f'{obj.name}_1024.npy'
+    points = np.load(points_path)
+    bps = np.load(bps_path)
+    if points.ndim != 2 or points.shape[1] != 3 or len(points) == 0:
+        raise ValueError(f'{points_path} must have shape (N, 3) with N > 0.')
+    if bps.shape not in ((1024, 3), (1, 1024, 3)):
+        raise ValueError(f'{bps_path} must encode 1024 three-dimensional BPS offsets.')
+    for array, path in ((points, points_path), (bps, bps_path)):
+        if array.dtype.kind not in 'fiu' or not np.isfinite(array).all():
+            raise ValueError(f'{path} must contain finite real coordinates.')
+    return points, bps.reshape(1, 1024, 3)
+
+
+def prompt_model_kwargs(prompts, n_frames):
+    geometry = {obj: load_object_geometry(obj) for obj in dict.fromkeys(prompt.object for prompt in prompts)}
+    max_points = max(len(points) for points, _ in geometry.values())
+    # Match the current dataset placeholder. The contact guide uses points, not normals.
+    normals = np.zeros((400, 3))
+    batch = []
+    for prompt in prompts:
+        points, bps = geometry[prompt.object]
+        # Repeating a surface point preserves the nearest-point search used by contact guidance.
+        points = np.pad(points, ((0, max_points - len(points)), (0, 0)), mode='edge')
+        batch.append({
+            'inp': torch.zeros(n_frames),
+            'lengths': n_frames,
+            'text': prompt.text,
+            'seq_name': prompt.object.label,
+            'obj_points': points,
+            'obj_normals': normals,
+            'obj_bps': bps,
+        })
+    _, model_kwargs = collate(batch)
+    return model_kwargs
