+def file_sha256(path):
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def save_results(run, args, result, objects, prompts, n_frames, contact_sampler):
+    np.save(run / 'results.npy', result)
+    (run / 'results.txt').write_text('\n'.join(result['text']), encoding='utf-8')
+    (run / 'results_len.txt').write_text('\n'.join(map(str, result['lengths'])), encoding='utf-8')
+
+    checkpoint = Path(args.model_path)
+    mesh_hashes = {obj: file_sha256(obj.mesh_path) for obj in dict.fromkeys(objects)}
+    samples = []
+    for index, (text, length) in enumerate(zip(result['text'], result['lengths'])):
+        repetition, position = divmod(index, args.num_samples)
+        obj = objects[position]
+        samples.append({
+            'index': index,
+            'repetition': repetition,
+            'prompt_id': prompts[position].id if prompts else None,
+            'text': text,
+            'dataset': obj.dataset,
+            'object_name': obj.name,
+            'mesh_path': str(obj.mesh_path.relative_to(DATA_ROOT.parent)),
+            'mesh_sha256': mesh_hashes[obj],
+            'valid_frames': int(length),
+        })
+    manifest = {
+        'mode': 'prompt' if prompts else 'dataset',
+        'sampler': 'local_generate_obj_guide_contactv2' if contact_sampler else 'local_generate_obj',
+        'contact_guidance': contact_sampler and args.guidance,
+        'checkpoint': {
+            'path': str(checkpoint.absolute()),
+            'sha256': file_sha256(checkpoint),
+            'args_sha256': file_sha256(checkpoint.with_name('args.json')),
+            'strict_state_dict': bool(prompts),
+        },
+        'arguments': vars(args),
+        'fps': FPS,
+        'generated_frames': n_frames,
+        'diffusion_steps': DIFFUSION_STEPS,
+        'samples': samples,
+    }
+    (run / 'run_manifest.json').write_text(json.dumps(manifest, indent=2) + '\n', encoding='utf-8')
+
