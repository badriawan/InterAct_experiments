+def stack_videos(inputs, output, direction):
+    command = ['ffmpeg', '-n', '-loglevel', 'error']
+    for path in inputs:
+        command.extend(['-i', str(path)])
+    if len(inputs) > 1:
+        command.extend(['-filter_complex', f'{direction}stack=inputs={len(inputs)}'])
+    else:
+        command.extend(['-c', 'copy'])
+    command.extend(['-movflags', '+faststart', str(output)])
+    subprocess.run(command, check=True)
